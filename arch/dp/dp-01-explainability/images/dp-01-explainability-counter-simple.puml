@startuml
title 사전학습 블랙박스 아키텍처
skinparam defaultFontName "AppleGothic"
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho

actor "사용자" as User
component "센서\nHR / GPS / 케이던스" as Sensors #FFF9C4

package "AI Operation Subsystem" {
  package "추론 서비스 (Inference)" as INF {
    component "이상값 필터" <<입력 가드레일>> as IG #FFE0B2
    component "블랙박스 결정 모델\n학습된 NN/부스팅 (+개인 어댑터)\n판정/코칭 직접 출력" <<모델 서빙: 블랙박스>> as MODEL #90A4AE
    component "사후 값 제한\n(결과 범위만 자름)" <<출력 가드레일>> as OG #FFE0B2
    IG --> MODEL
    MODEL --> OG
  }
  component "사후 설명 서비스\nLLM이 결정 뒤 이유 생성\n(원결정의 근사)" as POST #C8E6C9
  component "운영 서비스\nOperation UI + HITL/HOTL\n(결정 근거 불투명 → 수정 어려움)" as OPS #E1BEE7
}

package "AI Development (오프라인 대량 학습)" as DEV {
  database "Data Lake\n공개데이터 + 수집" as DL #CFD8DC
  component "오프라인 대량 학습\n+ 검증 + 배포" <<모델 학습>> as TRAIN #FFCCBC
  component "Model Registry\n학습된 모델 아티팩트" as REG #CFD8DC
  DL --> TRAIN
  TRAIN --> REG
}

Sensors --> IG
OG --> OPS
MODEL ..> POST : 결정 + 입력
POST --> OPS
User ..> OPS
REG ..> MODEL : 배포
OPS ..> MODEL : 미세조정 신호(약)

legend right
|= 색 |= 컴포넌트 성격 |
|<#FFE0B2>| 가드레일 (입출력 통제) |
|<#90A4AE>| 모델 서빙 (블랙박스) |
|<#C8E6C9>| 사후 설명 서비스 |
|<#E1BEE7>| 운영 서비스 (HITL/HOTL) |
|<#CFD8DC>| 저장 (Data Lake / Registry) |
|<#FFCCBC>| 오프라인 학습 (개발) |
|<#FFF9C4>| 외부 (센서) |
endlegend
@enduml
