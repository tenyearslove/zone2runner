@startuml
!pragma layout smetana
title (2안) ML 판정 뒤에 설명을 별도로 추정

skinparam defaultFontName "AppleGothic"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 24
skinparam ranksep 28
top to bottom direction

database "합성·공개 데이터" as SOURCE #CFD8DC
actor "사용자" as USER

package "AI Development Subsystem" {
  component "데이터셋 구축" as DATASET #FFCCBC
  component "Model Construction\nML 모델 학습" as TRAIN #FFCCBC
  component "Model Testing\n합성 기준값으로 검증" as TEST #FFAB91
  database "Model Registry" as REGISTRY #CFD8DC
  DATASET --> TRAIN
  TRAIN --> TEST
  TEST --> REGISTRY
}

package "AI Operation Subsystem" {
  package "추론 서비스 (Inference)" {
    component "모델 서빙\nML 판정·예측\n판단 근거를 직접 확인하기 어려움" as MODEL #90A4AE
  }
  package "설명 서비스 (Explanation)" {
    component "사후 설명 생성\n입력과 결과로 이유를 다시 추정" as POST #C8E6C9
  }
  package "운영 서비스 (Operation)" {
    component "Operation UI\n판정 결과와 추정 설명 표시" as UI #E1BEE7
  }
}

SOURCE --> DATASET
REGISTRY --> MODEL : 모델 배포
MODEL --> POST : 입력과 결과
MODEL --> UI : 판정 결과
POST --> UI : 추정한 설명
UI --> USER

note bottom of POST
  판정 뒤에 이유를 다시 추정하므로,
  설명이 실제 판단 근거와 다를 수 있다.
end note
@enduml
