@startuml
!pragma layout smetana
title (1안) LLM의 권한을 문장 표현으로 제한

skinparam defaultFontName "AppleGothic"
skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 24
skinparam ranksep 28
top to bottom direction

component "시스템 판단 ★\n코칭 방향과 숫자 확정" as DECISION #BBDEFB
component "LLM\n확정된 사실로\n문장만 생성" as LLM #E1F5FE
component "출력 검사 ★\n형식 · 방향 · 숫자" as GUARD #FFE0B2
component "생성 코칭" as PASS #C8E6C9
component "기본 안내\n생성 실패 또는 검사 탈락" as FALLBACK #FFF3E0
component "위험 심박 안내\nLLM을 거치지 않음" as SAFETY #FFCCBC
component "사용자 안내" as OUTPUT #E1BEE7
database "처리 기록\n채택 · 차단 · 전환 이유" as LOG #CFD8DC

DECISION --> LLM : 표현할 사실
LLM --> GUARD
GUARD --> PASS : 통과
GUARD --> FALLBACK : 기준 위반
LLM --> FALLBACK : 사용할 수 없음
DECISION --> SAFETY : 위험 심박
PASS --> OUTPUT
FALLBACK --> OUTPUT
SAFETY --> OUTPUT
GUARD --> LOG
FALLBACK --> LOG
@enduml
