@startuml
!pragma layout smetana
title (1안) 추론·운영 서비스가 LLM의 권한과 실패를 통제

skinparam defaultFontName "AppleGothic"
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 24
skinparam ranksep 28
top to bottom direction

component "심박 센서" as SENSOR #FFF9C4
actor "사용자" as USER

package "AI Operation Subsystem" {
  package "추론 서비스 (Inference)" {
    component "데이터 준비\n심박 · 페이스 · 세션 상태" as DATA #E1F5FE
    component "입력 가드레일\n센서 입력 정제" as INPUT #FFE0B2
    component "판정 규칙 ★\n코칭 방향과 숫자 확정" as DECISION #BBDEFB
    component "LLM 모델 서빙\n확정된 사실로 문장만 생성" as LLM #E1F5FE
    component "출력 가드레일 ★\n형식 · 방향 · 숫자 검사" as OUTPUT #FFE0B2
    DATA --> DECISION
    INPUT --> DECISION
    DECISION --> LLM : 표현할 사실
    LLM --> OUTPUT
  }

  package "운영 서비스 (Operation)" {
    component "추론 제어\n모델 준비 상태와 실패 전환" as CONTROL #E1BEE7
    component "운영 조치 ★\n기본 안내 · 위험 심박 안내" as ACTION #FFCCBC
    component "Operation UI\n모델 상태 · 처리 결과 확인" as UI #E1BEE7
    CONTROL --> ACTION : 생성 실패
    CONTROL --> UI : 모델 상태
  }

  package "분석 서비스 (Analysis)" {
    database "서빙 로그\n채택 · 차단 · 전환 이유" as LOG #CFD8DC
  }
}

SENSOR --> INPUT
CONTROL --> LLM : 준비 완료
DECISION --> ACTION : 위험 심박
OUTPUT --> ACTION : 통과 또는 탈락
OUTPUT --> LOG : 검사 결과
CONTROL --> LOG : 실패 전환
ACTION --> USER
LOG --> UI
USER --> UI

note bottom of ACTION
  판정 기준이 LLM 밖에 있어 출력을 검사·차단할 수 있다.
  생성에 실패해도 기본 안내로 전환한다.
end note
@enduml
