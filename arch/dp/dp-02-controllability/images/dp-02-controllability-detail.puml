@startuml
title DP2 채택안 상세 — 통제 경로를 하위 모듈(실제 클래스)까지 전개
skinparam defaultFontName "AppleGothic"
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho

actor "사용자" as USER
component "TTS 음성" as TTS #FFF9C4
component "Gemini Nano\n(AICore)" as NANO #FFF9C4

package "판단 — 정답이 만들어지는 곳" {
  component "RunEngine\n코칭 트리거(존 이탈/드리프트)" as RE #BBDEFB
  component "ZoneJudge + Personalization\n판정과 개인 경계(정답 방향)" as JP #BBDEFB
}

package "표현 — 추상도의 «LLM = 문장만» 내부" {
  component "CoachPrompt\n사실+임무 간결 프롬프트" as CP #E1F5FE
  component "LlmCoach.sayInner\n토글(llmEnabled) → 로딩 보류(resolved)\n→ 가용성(ensureReady) → 생성 6초 제한" <<모델 서빙: LLM>> as LC #BBDEFB
}

package "출력 검사 — 추상도의 «출력 가드레일» 내부" {
  component "형식 가드\n2문장/90자/이모지 제거" as G1 #FFE0B2
  component "DirectionGuard\n정답 방향과 대조 — 모순·무방향 기각\n(특수 코칭은 가속 명령 금지)" as G2 #FFE0B2
  component "NumberGuard\n출력 숫자 ⊆ 입력 사실" as G3 #FFE0B2
}

package "폴백·안전 — 실패해도 멈추지 않음" {
  component "RuleCoach\n단어 수준 기본 문구\n(속도 줄이기 / 회복 중)" as RC #FFE0B2
  component "SafetyGuard\n최대심박 95% 15초 지속\n→ LLM 우회 즉시 권고(30초 재경고)" as SG #FFE0B2
  component "NanoModelManager\n모델 상태/다운로드(세션 밖)" as NMM #C5CAE9
}

package "개입·감사 — 사람의 통제 수단" {
  component "말하기 테스트(HITL)\n판정 기준 정정, 세션 내 ±10bpm 한도" as TALK #E1BEE7
  component "AppSettings(HOTL)\n코칭 빈도/말투/더위 토글" as SET #E1BEE7
  component "LlmCallLog\n경로·기각 사유 기록" as LOG #CFD8DC
  database "SessionStore\n세션마다 영속" as SS #CFD8DC
  component "ReportActivity\nLLM 사용 카드(채택/기각/폴백)" as RPT #E1BEE7
}

RE --> JP
JP --> CP : 방향+사실
CP --> LC
NANO ..> LC
LC --> G1
G1 --> G2
G2 --> G3
G3 --> TTS : 통과
G2 --> RC : 기각
G3 --> RC : 기각
LC --> RC : 미가용/실패
RC --> TTS
JP --> SG : 위험 심박
SG --> TTS : 규칙 권고
NMM ..> NANO : 준비 상태
LC ..> LOG
LOG --> SS
SS --> RPT
USER ..> TALK
TALK ..> JP
USER ..> SET
SET ..> RE
USER ..> RPT

legend right
|= 색 |= 성격 |
|<#FFE0B2>| 가드레일/폴백/안전 |
|<#BBDEFB>| 모델 서빙 |
|<#E1F5FE>| 데이터 준비 |
|<#C5CAE9>| 서빙 로직(모델 준비) |
|<#CFD8DC>| 저장(감사) |
|<#E1BEE7>| 운영(개입/열람) |
|<#FFF9C4>| 외부 |
endlegend
@enduml
