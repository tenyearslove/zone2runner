@startuml
!pragma layout smetana
title (2안) LLM에 판단과 표현을 함께 맡김

skinparam defaultFontName "AppleGothic"
skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 24
skinparam ranksep 28
top to bottom direction

component "심박 · 페이스\n세션 상태" as INPUT #FFF9C4
component "프롬프트 규정\n할 일과 금지 사항" as PROMPT #CFD8DC
component "LLM 판단과 문장 생성\n코칭 여부 · 방향 · 내용 결정" as LLM #90A4AE
component "간단한 출력 검사\n길이 · 금칙어 · 숫자 범위" as FILTER #FFE0B2
component "코칭 출력" as OUTPUT #E1BEE7
actor "사용자" as USER

INPUT --> LLM
PROMPT --> LLM
LLM --> FILTER
FILTER --> OUTPUT
OUTPUT --> USER
@enduml
