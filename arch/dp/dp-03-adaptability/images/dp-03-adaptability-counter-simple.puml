@startuml
!pragma layout smetana
title (2안) 서버 재학습으로 개인화를 반영

skinparam defaultFontName "AppleGothic"
skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 24
skinparam ranksep 28
top to bottom direction

actor "사용자" as USER
component "러닝과 응답" as RUN #E1BEE7
database "여러 사용자의\n기록 수집" as DATA #CFD8DC
component "모델 재학습\n복잡한 패턴 학습" as TRAIN #FFCCBC
component "검증과 배포" as DEPLOY #FFAB91
component "새 개인화 모델\n이후 러닝부터 사용" as MODEL #90A4AE

USER -right-> RUN
RUN -right-> DATA : 서버 전송
DATA -down-> TRAIN : 충분한 데이터가 모이면
TRAIN -right-> DEPLOY
DEPLOY -right-> MODEL
@enduml
