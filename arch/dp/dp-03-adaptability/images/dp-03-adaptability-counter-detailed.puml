@startuml
title 오프라인 재학습 개인화 아키텍처 (상세)
skinparam defaultFontName "Malgun Gothic"
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho

actor "사용자" as User
component "센서\nHR / GPS / 케이던스" as Sensors #FFF9C4

package "AI Operation Subsystem (폰)" {
  component "이상값 필터" <<입력 가드레일>> as IG #FFE0B2
  component "특징 추출\n세션 통계/추세" as FE #E1F5FE
  component "개인화 모델 서빙 (배포본 vN)\n개인 경계 산출\n배포 사이 경계 고정" <<모델 서빙: 블랙박스>> as SERVE #90A4AE
  component "존 판정/코칭\n(경계 소비)" as JUDGE #BBDEFB
  component "운영 서비스\nOperation UI + 설정" as OPS #E1BEE7
  component "라벨/세션 수집기\n관측 + 말하기 테스트 답\n+ 동의/전송 관리" as COLL #E1F5FE
  IG --> FE
  FE --> SERVE
  SERVE --> JUDGE
  JUDGE --> OPS
}

package "AI Development Subsystem (서버) - 적응의 본체" {
  database "Data Lake\n전체 사용자 세션/라벨\n(코호트 데이터)" as DL #CFD8DC
  component "Feature Store\n학습 특징 관리" as FS #CFD8DC
  component "Model Construction\n개인 + 코호트 재학습\n(일/주 주기)" <<Retraining>> as MC #FFAB91
  component "모델 테스팅\n홀드아웃/오프라인 지표\n(참값 없어 근사 채점)" as TEST #FFAB91
  database "Model Registry\nvN, vN+1, ..." as REG #CFD8DC
  component "배포 파이프라인\n단계 배포/롤백" as DEPLOY #FFAB91
  DL --> FS
  FS --> MC
  MC --> TEST
  TEST --> REG
  REG --> DEPLOY
}

Sensors --> IG
User ..> OPS : 말하기 테스트 답/피드백
OPS ..> COLL
COLL --> DL : 업로드(네트워크 필요)
DEPLOY ..> SERVE : vN+1 배포\n= 적응 반영 시점
note bottom of DEPLOY
  개인 변화 감지 → 경계 반영 지연
  = 수집 + 재학습 + 배포 주기 (일/주)
  개입 효과 확인도 다음 배포 후
end note

legend right
|= 색 |= 컴포넌트 성격 |
|<#FFE0B2>| 가드레일 (입출력 통제) |
|<#E1F5FE>| 데이터 준비/수집 |
|<#90A4AE>| 모델 서빙 (블랙박스) |
|<#BBDEFB>| 판정/코칭 (경계 소비) |
|<#E1BEE7>| 운영 서비스 (HITL/HOTL) |
|<#CFD8DC>| 저장 (Data Lake / Registry) |
|<#FFAB91>| 개발/학습 (오프라인) |
|<#FFF9C4>| 외부 (센서) |
endlegend
@enduml
