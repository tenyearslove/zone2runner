@startuml
title 카운터 아키텍처 (블랙박스 + 사후 설명) — C&C 상세
skinparam defaultFontName "AppleGothic"
skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho

actor "사용자" as User
component "센서\nHR / GPS / 케이던스" as Sensors
component "실제 도착값 / 라벨" as H

package "AI Operation Subsystem" {

  package "추론 서비스 (Inference Service)" as INF {
    component "전처리 / 정규화\n최근 N초 이력 윈도우" <<데이터 준비>> as PRE
    component "이상값 필터" <<입력 가드레일>> as IG
    component "블랙박스 결정 모델\n학습된 NN / 부스팅 — 판정·코칭 직접 출력" <<모델 서빙: 블랙박스>> as MODEL
    component "개인 어댑터\n사전학습 모델 미세조정" <<모델 서빙: 개인화>> as ADAPTER
    component "사후 클리핑\n(생리 모름 — 값 범위만 제한)" <<출력 가드레일>> as OG
  }

  package "설명 서비스 (사후 / post-hoc)" as EXP {
    component "사후 설명기\nSHAP / LIME 기여도 또는 LLM 이유생성\n(원모델의 근사)" as POST
  }

  package "분석 서비스 (Analysis)" as ANASVC {
    database "서빙 로그" as SLOG
    component "모니터링 지표" as MON
  }

  package "운영 서비스 (Operation)" as OPSVC {
    component "Operation UI\nattribution 숫자 / LLM 서사" as UI
    component "HITL / HOTL 제어\n(불투명 결정 — 반박 지점 모호)" as CTRL
  }
}

package "AI Development Subsystem (완전판 — 오프라인 학습)" as DEV {
  component "데이터셋 구축" as DSET
  database "Data Lake\n공개데이터(FitRec 등) + 수집 세션" as DLAKE
  component "재학습 데이터셋 추출" as REEX

  package "Model Construction (오프라인 학습)" as MC {
    component "데이터 준비" as MPREP
    component "입력 가드레일" as MIG
    component "모델 학습\n(대량 데이터, 오프라인)" <<모델 학습>> as TRAIN
    component "출력 가드레일" as MOG
    MPREP --> MIG
    MIG --> TRAIN
    TRAIN --> MOG
  }
  database "Model Artifact" as MART
  database "ML Metadata" as MMETA
  component "모델 테스팅\n홀드아웃 테스트셋\n(우리 도메인엔 참값 없음)" <<모델 테스팅>> as MTEST
  component "모델 등록 / 승격" as MPROM
}

component "Model Registry / Container Registry\n학습된 모델 아티팩트 + 패키지" as REG

' ===== 운영 데이터 흐름 =====
Sensors --> PRE
PRE --> IG
IG --> MODEL
MODEL --> ADAPTER
ADAPTER --> OG
OG --> UI
OG --> SLOG
SLOG --> MON

' ===== 사후 설명(근사) =====
MODEL ..> POST : 결정 + 입력
POST --> UI
User ..> CTRL
CTRL ..> ADAPTER : 미세조정 신호(약)

' ===== 오프라인 학습 파이프라인 =====
DSET --> DLAKE
DLAKE --> MPREP
TRAIN --> MART
TRAIN --> MMETA
MART --> MTEST
MTEST --> MPROM
MPROM --> REG
REG ..> MODEL : 배포
H ..> ADAPTER : 온라인 미세조정
MON ..> REEX : Retraining 트리거
REEX --> DLAKE
@enduml
